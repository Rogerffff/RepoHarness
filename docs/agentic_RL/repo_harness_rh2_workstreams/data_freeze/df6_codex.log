codex
R2E 元数据中正好有 10 个不同仓库，所以 R2E 抽样会覆盖全部 10 个仓库，每个仓库随机取 1 个镜像；SWE-Gym 使用固定随机种子从 2438 条 Full 清单中抽 10 个。
exec
/bin/zsh -lc "{
  printf 'dataset\\titem\\timage_ref\\tsize_bytes\\tsize_gib\\tdigest\\n'
  cat /tmp/df6_sample_swegym.tsv /tmp/df6_sample_r2e.tsv | while IFS="'$'"'\\t' read -r dataset item ref; do
    name_tag="'${ref#*/}
    namespace=${ref%%/*}
    repo=${name_tag%:*}
    tag=${name_tag##*:}
    url="https://hub.docker.com/v2/repositories/${namespace}/${repo}/tags/${tag}"
    body=$(curl -sS "$url")
    size=$(printf '"'%s' \""'$body" | jq -r '"'.full_size // empty')
    digest="'$(printf '"'%s' \""'$body" | jq -r '"'.digest // empty')
    if [ -z \""'$size" ]; then
      printf '"'ERROR\\t%s\\t%s\\t%s\\t\\t\\t%s\\n' \""'$dataset" "$item" "$ref" "$(printf '"'%s' \""'$body" | jq -c '"'.')\" >&2
      exit 1
    fi
    gib="'$(awk -v b="$size" '"'BEGIN { printf \"%.3f\", b/1024/1024/1024 }')
    printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \""'$dataset" "$item" "$ref" "$size" "$gib" "$digest"
    sleep 0.2
  done
} > /tmp/df6_sample_sizes.tsv
