  "savez_lines": [
    {
      "line": 660,
      "text": "def _savez(file, args, kwds, compress, allow_pickle=True, pickle_kwargs=None):"
    },
    {
      "line": 661,
      "text": "    # Import is postponed to here since zipfile depends on gzip, an optional"
    },
    {
      "line": 662,
      "text": "    # component of the so-called standard library."
    },
    {
      "line": 663,
      "text": "    import zipfile"
    },
    {
      "line": 664,
      "text": "    # Import deferred for startup time improvement"
    },
    {
      "line": 665,
      "text": "    import tempfile"
    },
    {
      "line": 666,
      "text": ""
    },
    {
      "line": 667,
      "text": "    if isinstance(file, basestring):"
    },
    {
      "line": 668,
      "text": "        if not file.endswith('.npz'):"
    },
    {
      "line": 669,
      "text": "            file = file + '.npz'"
    },
    {
      "line": 670,
      "text": "    elif is_pathlib_path(file):"
    },
    {
      "line": 671,
      "text": "        if not file.name.endswith('.npz'):"
    },
    {
      "line": 672,
      "text": "            file = file.parent / (file.name + '.npz')"
    },
    {
      "line": 673,
      "text": ""
    },
    {
      "line": 674,
      "text": "    namedict = kwds"
    },
    {
      "line": 675,
      "text": "    for i, val in enumerate(args):"
    },
    {
      "line": 676,
      "text": "        key = 'arr_%d' % i"
    },
    {
      "line": 677,
      "text": "        if key in namedict.keys():"
    },
    {
      "line": 678,
      "text": "            raise ValueError("
    },
    {
      "line": 679,
      "text": "                \"Cannot use un-named variables and keyword %s\" % key)"
    },
    {
      "line": 680,
      "text": "        namedict[key] = val"
    },
    {
      "line": 681,
      "text": ""
    },
    {
      "line": 682,
      "text": "    if compress:"
    },
    {
      "line": 683,
      "text": "        compression = zipfile.ZIP_DEFLATED"
    },
    {
      "line": 684,
      "text": "    else:"
    },
    {
      "line": 685,
      "text": "        compression = zipfile.ZIP_STORED"
    },
    {
      "line": 686,
      "text": ""
    },
    {
      "line": 687,
      "text": "    zipf = zipfile_factory(file, mode=\"w\", compression=compression)"
    },
    {
      "line": 688,
      "text": ""
    },
    {
      "line": 689,
      "text": "    # Stage arrays in a temporary file on disk, before writing to zip."
    },
    {
      "line": 690,
      "text": ""
    },
    {
      "line": 691,
      "text": "    # Since target file might be big enough to exceed capacity of a global"
    },
    {
      "line": 692,
      "text": "    # temporary directory, create temp file side-by-side with the target file."
    },
    {
      "line": 693,
      "text": "    file_dir, file_prefix = os.path.split(file) if _is_string_like(file) else (None, 'tmp')"
    },
    {
      "line": 694,
      "text": "    fd, tmpfile = tempfile.mkstemp(prefix=file_prefix, dir=file_dir, suffix='-numpy.npy')"
    },
    {
      "line": 695,
      "text": "    os.close(fd)"
    },
    {
      "line": 696,
      "text": "    try:"
    },
    {
      "line": 697,
      "text": "        for key, val in namedict.items():"
    },
    {
      "line": 698,
      "text": "            fname = key + '.npy'"
    },
    {
      "line": 699,
      "text": "            fid = open(tmpfile, 'wb')"
    },
    {
      "line": 700,
      "text": "            try:"
    },
    {
      "line": 701,
      "text": "                format.write_array(fid, np.asanyarray(val),"
    },
    {
      "line": 702,
      "text": "                                   allow_pickle=allow_pickle,"
    },
    {
      "line": 703,
      "text": "                                   pickle_kwargs=pickle_kwargs)"
    },
    {
      "line": 704,
      "text": "                fid.close()"
    },
    {
      "line": 705,
      "text": "                fid = None"
    },
    {
      "line": 706,
      "text": "                zipf.write(tmpfile, arcname=fname)"
    },
    {
      "line": 707,
      "text": "            except IOError as exc:"
    },
    {
      "line": 708,
      "text": "                raise IOError(\"Failed to write to %s: %s\" % (tmpfile, exc))"
    },
    {
      "line": 709,
      "text": "            finally:"
    },
    {
      "line": 710,
      "text": "                if fid:"
    },
    {
      "line": 711,
      "text": "                    fid.close()"
    },
    {
      "line": 712,
      "text": "    finally:"
    },
    {
      "line": 713,
      "text": "        os.remove(tmpfile)"
    },
    {
      "line": 714,
      "text": ""
    },
    {
      "line": 715,
      "text": "    zipf.close()"
    }
