     """
+    for acronym in ('HTTP', 'HTTPS', 'URL', 'API', 'JSON', 'XML', 'ID'):
+        camel = re.sub(f'({acronym})([A-Z][a-z])', lambda m: f'{m.group(1)}_{m.group(2)}', camel)
