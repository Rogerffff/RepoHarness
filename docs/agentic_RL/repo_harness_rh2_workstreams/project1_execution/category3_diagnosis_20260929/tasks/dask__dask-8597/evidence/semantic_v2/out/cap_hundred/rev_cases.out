        {('y', 0): (<function getitem at ...>, ('x', 0), (array([5, 1]),)),
         ('y', 1): (<function getitem at ...>, ('x', 2), (array([7]),)),
         ('y', 2): (<function getitem at ...>, ('x', 0), (array([3]),))}
    
