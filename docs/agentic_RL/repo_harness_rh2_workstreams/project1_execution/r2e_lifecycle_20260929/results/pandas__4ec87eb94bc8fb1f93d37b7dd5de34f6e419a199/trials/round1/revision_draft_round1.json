 "template": "R-c",
 "items": [
  {
   "id": "R-c-1",
   "fixes": "T2b（v1 §4 第 3 步）：退化候选 C0（out = vals._data，不按掩码置 NaN）在当前材料正式评分 1.0（237/237），但对 astype / reindex / Int64 除法产生的 NA 算错",
   "new_key": "test_groupby_quantile_NA_float_nonnan_storage"
  }
 ],
 "revisions": [
  {
   "kind": "hidden_test_text_replace",
   "target": "test_1.py",
   "edits": [
    {
     "old": "def test_groupby_timedelta_quantile():\n",
     "new": "def test_groupby_quantile_NA_float_nonnan_storage():\n    # GH#42849, general case: a value is missing iff its mask is set,\n    # whatever the underlying data holds at that position.\n    # Int64 -> Float64: the masked slot keeps the integer array's filler (1.0).\n    ser = pd.Series(pd.array([1, None, 3], dtype=\"Int64\").astype(\"Float64\"))\n    result = ser.groupby([0, 0, 0]).quantile(0.5)\n    tm.assert_series_equal(result, pd.Series([2.0], index=[0]), check_dtype=False)\n\n    # NA introduced by reindex (0.0 under the mask); two groups, one of them\n    # with two valid values.\n    ser = pd.Series([2.5, 3.5, 4.0], dtype=\"Float64\").reindex([0, 1, 2, 3])\n    result = ser.groupby([\"a\", \"a\", \"b\", \"b\"]).quantile(0.5)\n    tm.assert_series_equal(\n        result, pd.Series([3.0, 4.0], index=[\"a\", \"b\"]), check_dtype=False\n    )\n\n\ndef test_groupby_timedelta_quantile():\n"
    }
   ]
  }
 ],
