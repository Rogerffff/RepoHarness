+@mock_rds
+@mock_neptune
+def test_rds_facade_preserves_neptune_name_start():
+    backend = rds_backends[ACCOUNT_ID]["us-east-1"]
+    name = "preserved-neptune-start"
+    cluster = backend.neptune.create_db_cluster(
+        db_cluster_identifier=name, storage_encrypted="false"
+    )
+    assert cluster.status == "available"
+    result = backend.start_db_cluster(name)
+    assert result.db_cluster_identifier == name
+    assert result.status == "started"
+    assert name in backend.neptune.clusters
+
+
+@mock_rds
+@mock_neptune
+def test_rds_facade_preserves_neptune_name_delete():
+    backend = rds_backends[ACCOUNT_ID]["us-east-1"]
+    name = "preserved-neptune-delete"
+    backend.neptune.create_db_cluster(
+        db_cluster_identifier=name, storage_encrypted="false"
+    )
+    assert name in backend.neptune.clusters
+    result = backend.delete_db_cluster(name)
+    assert result.db_cluster_identifier == name
+    assert name not in backend.neptune.clusters
