@@ -0,0 +1,41 @@
+import asyncio
+from aiohttp import web
+import logging
+
+# Test that shows the expected behavior for properly handled exceptions
+# We'll create a scenario where an exception in cleanup context is expected to be raised
+# and verify it's only logged once
+
+def test_issue_scenario():
+    """Test the exact scenario from the issue"""
+    print("=== Testing Issue Scenario ===")
+
+    async def context(app: web.Application):
+        raise RuntimeError("Unexpected error occurred")
+        yield
+
+    app = web.Application()
+    app.cleanup_ctx.append(context)
+
+    # This should raise RuntimeError but not log it twice
+    try:
+        web.run_app(app)
+        print("ERROR: Should have raised an exception!")
+        return False
+    except RuntimeError as e:
+        if str(e) == "Unexpected error occurred":
+            print("✓ Correctly raised RuntimeError")
+            return True
+        else:
+            print(f"✗ Wrong exception message: {e}")
+            return False
+    except Exception as e:
+        print(f"✗ Wrong exception type: {type(e)}: {e}")
+        return False
+
+if __name__ == "__main__":
+    success = test_issue_scenario()
+    if success:
+        print("\n✓ Issue has been fixed!")
+    else:
+        print("\n✗ Issue still exists!")
