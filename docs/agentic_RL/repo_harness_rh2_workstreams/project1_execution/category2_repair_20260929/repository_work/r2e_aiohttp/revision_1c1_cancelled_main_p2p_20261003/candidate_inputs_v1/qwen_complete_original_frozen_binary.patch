--- a/aiohttp/web.py
+++ b/aiohttp/web.py
@@ -441,6 +441,14 @@ def _cancel_tasks(
     if not to_cancel:
         return
 
+    # Track tasks that were already done before cancellation attempt.
+    # These tasks have exceptions that are being raised to the caller,
+    # so we should not log them again via call_exception_handler.
+    already_done: Set["asyncio.Task[Any]"] = set()
+    for task in to_cancel:
+        if task.done():
+            already_done.add(task)
+
     for task in to_cancel:
         task.cancel()
 
@@ -450,6 +458,10 @@ def _cancel_tasks(
         if task.cancelled():
             continue
         if task.exception() is not None:
+            # Skip logging if task was already done before cancellation.
+            # The exception is being raised to the caller and will be logged there.
+            if task in already_done:
+                continue
             loop.call_exception_handler(
                 {
                     "message": "unhandled exception during asyncio.run() shutdown",
