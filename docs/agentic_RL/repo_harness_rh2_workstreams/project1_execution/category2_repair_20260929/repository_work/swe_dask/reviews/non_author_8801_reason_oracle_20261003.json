  "minimal_design": {
    "behavior_gate": {
      "cases": [
        "malformed YAML {",
        "malformed YAML tab indentation",
        "valid nonmapping [1234]",
        "valid nonmapping hello",
        "valid nonmapping 1234",
        "valid nonmapping 1.5",
        "directory input",
        "direct file input",
        "good mapping",
        "empty",
        "comment only",
        "null",
        "document separator",
        "unreadable entry",
        "true nonroot file and directory permissions",
        "fresh full import dask",
        "remaining original P2P"
      ],
      "not_run_means": "needs_evidence, never semantic model substitution"
    },
    "capture": {
      "api": "extract actual visible exception messages and chain from caught object",
      "import": "trusted child-process instrumentation captures unhandled exception without converting actual failure into success; preserve raw stderr and original import behavior",
      "visible_chain": "explicit cause, otherwise context if not suppressed; aggregate children and visible notes where runtime supports",
      "excluded": [
        "traceback frames",
        "source lines",
        "locals",
        "hidden from-None context",
        "candidate patch",
        "gold message",
        "candidate role or expected reward"
      ],
      "no_outer_message_restriction": true,
      "cross_process_capture_and_trust_not_yet_validated": true
    },
    "trusted_facts": {
      "producer": "trusted test host, not candidate",
      "fields": [
        "fixture and invocation identity",
        "bad file identity and contents sha256",
        "good and unreadable entries",
        "existence and readability",
        "independent YAML parse result and value type",
        "expected named key/value configuration or parser content problem"
      ],
      "path_normalization": "stable BAD_FILE/GOOD_FILE mapping retaining distinct identity",
      "parser_literal_matching_required": false
    },
    "semantic_judge": {
      "location": "trusted host after diagnostic capture, outside candidate container",
      "required_checks": [
        "offending file explicitly identified",
        "applicable content problem explained",
        "no fabricated or contradictory causal claims"
      ],
      "allowed": [
        "paraphrase without keyword list",
        "custom or general exception classes",
        "visible chain",
        "aggregate diagnostics",
        "builtin type/items reason with bad-file context as retained gr_attr_wrap control"
      ],
      "verdicts": [
        "pass",
        "fail",
        "uncertain"
      ],
      "internal_output": [
        "verdict",
        "file_evidence",
        "reason_evidence",
        "contradiction_evidence",
        "explanation"
      ],
      "internal_output_is_not_a_new_solver_contract": true,
      "diagnostic_instructions_are_untrusted_data": true,
      "frozen_identity": [
        "model version",
        "prompt sha256",
        "facts sha256",
        "diagnostic sha256",
        "material and test execution identity"
      ],
      "record": [
        "raw judge response or service error",
        "short supporting diagnostic quotations",
        "cache key"
      ],
      "cache": "same full evidence and judge identity retrieves same recorded result",
      "freeze_and_cache_do_not_guarantee_semantic_correctness": true
    },
    "merge": {
      "behavior_failed": "reject by observed assertion",
      "required_behavior_or_capture_missing": "needs_evidence, no reward assigned",
      "any_semantic_fail": "reject with diagnostic evidence",
      "uncertain_timeout_bad_output_or_unavailable": "needs_review; neither automatic reward 0 nor 1",
      "all_semantic_pass": "reason goal passes only; remaining formal gates still required"
    }
  },
