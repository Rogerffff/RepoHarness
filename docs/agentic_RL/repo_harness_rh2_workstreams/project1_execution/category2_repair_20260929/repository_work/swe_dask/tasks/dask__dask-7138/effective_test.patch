+def test_ravel_with_array_like():
+    # int
+    assert_eq(np.ravel(0), da.ravel(0))
+    assert isinstance(da.ravel(0), da.core.Array)
+
+    # list
+    assert_eq(np.ravel([0, 0]), da.ravel([0, 0]))
+    assert isinstance(da.ravel([0, 0]), da.core.Array)
+
+    # tuple
+    assert_eq(np.ravel((0, 0)), da.ravel((0, 0)))
+    assert isinstance(da.ravel((0, 0)), da.core.Array)
+
+    # nested i.e. tuples in list
+    assert_eq(np.ravel([(0,), (0,)]), da.ravel([(0,), (0,)]))
+    assert isinstance(da.ravel([(0,), (0,)]), da.core.Array)
+
+    values = [[1, -2], [3, 4]]
+    result = da.ravel(values)
+    assert isinstance(result, da.core.Array)
+    assert_eq(result, np.ravel(values))
+
+
+def test_ravel_keyword_array():
+    # 既有公开签名为 ravel(array)，增加转换时仍须兼容关键字调用。
+    values = np.arange(6).reshape((2, 3))
+    array = da.from_array(values, chunks=(1, 3))
+    result = da.ravel(array=array)
+    assert isinstance(result, da.core.Array)
+    assert_eq(result, np.ravel(values))
+
+
