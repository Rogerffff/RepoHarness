 def _check_url(url, **fields):
     """just a helper to carry out few checks on urls"""
     url_ = URL(**fields)
+    parsed = URL(url)
+    # 直接比较公开字段，不让 URL.__eq__ 决定解析是否正确。
+    for f in ('scheme', 'username', 'password', 'hostname',
+              'port', 'path', 'query', 'fragment'):
+        eq_(getattr(parsed, f), fields.get(f, ''))
     eq_(URL(url), url_)
     eq_(str(URL(url)), url)
     eq_(url, url_)  # just in case ;)  above should fail first if smth is wrong
