        "content": "import numpy as np\nfrom monai.data import SmartCacheDataset\n\ndef test_smartcache_shuffle_fix():\n    \"\"\"Test that SmartCacheDataset doesn't modify input data when shuffle=True\"\"\"\n\n    # Test 1: Original bug reproduction\n    print(\"=== Test 1: Original Bug Reproduction ===\")\n    data_list = list(np.array([i]) for i in range(5))\n    original_data = [item.copy() for item in data_list]  # Make a copy for comparison\n    print(\"original datalist:\", data_list)\n\n    dataset = SmartCacheDataset(\n        data=data_list,\n        transform=None,\n        cache_rate=0.5,\n        replace_rate=0.4,\n        shuffle=True,\n    )\n\n    print(\"datalist after dataset:\", data_list)\n\n    # Check if original data is preserved\n    data_preserved = all(np.array_equal(a, b) for a, b in zip(data_list, original_data))\n    print(f\"Original data preserved: {data_preserved}\")\n\n    # Test 2: Verify dataset still works correctly with shuffling\n    print(\"\\n=== Test 2: Dataset Functionality ===\")\n    data_list2 = list(range(10))\n    original_data2 = data_list2.copy()\n\n    dataset2 = SmartCacheDataset(\n        data=data_list2,\n        transform=None,\n        cache_rate=0.5,\n        replace_rate=0.4,\n        shuffle=True,\n        seed=42  # Fixed seed for reproducible results\n    )\n\n    print(f\"Original data: {original_data2}\")\n    print(f\"Data after dataset creation: {data_list2}\")\n    print(f\"Original data preserved: {data_list2 == original_data2}\")\n\n    # Test 3: Test without shuffle (should work as before)\n    print(\"\\n=== Test 3: Shuffle=False ===\")\n    data_list3 = list(range(5))\n    original_data3 = data_list3.copy()\n\n    dataset3 = SmartCacheDataset(\n        data=data_list3,\n        transform=None,\n        cache_rate=0.5,\n        replace_rate=0.4,\n        shuffle=False,\n    )\n\n    print(f\"Original data: {original_data3}\")\n    print(f\"Data after dataset creation: {data_list3}\")\n    print(f\"Original data preserved: {data_list3 == original_data3}\")\n\n    print(\"\\n=== All tests completed ===\")\n\nif __name__ == \"__main__\":\n    test_smartcache_shuffle_fix()"
