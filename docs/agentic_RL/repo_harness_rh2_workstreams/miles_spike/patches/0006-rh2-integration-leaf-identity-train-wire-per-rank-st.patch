+def compute_leaf_ordinals(rollout_keys: list) -> list[int]:
+    """[rh2-integration] Occurrence index of each sample within its agent run.
+
+    ``rollout_keys`` is the per-sample run key column (``rollout_ids``: the
+    sample's ``rollout_id``, falling back to ``index``). Fan-out siblings share
+    that key, so the running occurrence count is a stable per-leaf ordinal as
+    long as callers iterate the same flattened sample list in the same order --
+    which conversion and the rollout-side evidence emitter both do.
+    """
+    seen: dict = {}
+    ordinals: list[int] = []
+    for key in rollout_keys:
+        ordinal = seen.get(key, 0)
+        seen[key] = ordinal + 1
+        ordinals.append(ordinal)
+    return ordinals
+
+
