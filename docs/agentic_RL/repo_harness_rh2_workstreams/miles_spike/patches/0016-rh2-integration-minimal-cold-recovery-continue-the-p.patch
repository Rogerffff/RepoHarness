     # -------------------------- offload/onload -----------------------------
 
@@ -551,6 +562,12 @@ class RolloutManager:
         )
 
     async def set_weight_version(self, weight_version: int):
+        # [rh2-integration] W5b (B-3): the first publish of a restarted run is train_async's bootstrap
+        # publish. The trainer restored its updater counter to p-1 from the same state file this actor
+        # restored p from, so that publish must carry exactly p; anything else means trainer and rollout
