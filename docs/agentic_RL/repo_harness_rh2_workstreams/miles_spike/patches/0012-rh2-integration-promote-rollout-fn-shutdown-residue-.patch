+# ---------------------------------------------------------------------------
+# typed shutdown failure (serializable)
+# ---------------------------------------------------------------------------
+
+
+def shutdown_failure_from_aclose(fn_report: dict[str, Any] | None, *, aclose_error: str | None = None) -> dict[str, Any] | None:
+    """Every residue of ``FullyAsyncRolloutFn.aclose()`` -> one typed failure, or None when clean.
+
+    ``problems`` kinds: ``aclose_raised`` / ``worker_unfinished`` / ``active_groups_unfinished``
+    (with the concrete group identities) / ``close_error`` / ``buffer_not_closed`` /
+    ``deadline_exceeded``.
+    """
+
+    problems: list[dict[str, Any]] = []
+    if aclose_error is not None:
+        problems.append({"kind": "aclose_raised", "reason": aclose_error})
+    report = fn_report or {}
+    if report.get("worker_unfinished"):
+        problems.append(
+            {"kind": "worker_unfinished", "reason": "worker task still running when the cancel deadline passed"}
+        )
+    unfinished = int(report.get("active_groups_unfinished") or 0)
+    if unfinished:
+        problems.append(
+            {
+                "kind": "active_groups_unfinished",
+                "count": unfinished,
+                "groups": list(report.get("active_groups_unfinished_facts") or []),
+                "reason": "active group tasks still running when the cancel deadline passed",
+            }
+        )
+    if report.get("close_error"):
+        problems.append({"kind": "close_error", "reason": str(report["close_error"])})
+    if fn_report is not None and not report.get("buffer_closed"):
+        problems.append(
+            {"kind": "buffer_not_closed", "reason": "data buffer aclose() did not complete; put/get waiters may hang"}
+        )
+    if not problems and report.get("deadline_exceeded"):
+        problems.append({"kind": "deadline_exceeded", "reason": "deadline exceeded without identified residue"})
+    if not problems:
+        return None
+    return {
+        "schema_id": SHUTDOWN_FAILURE_SCHEMA_ID,
+        "kind": "rollout_fn_shutdown_incomplete",
+        "problems": problems,
+        "worker_state": report.get("worker_state"),
+        "deadline_seconds": report.get("deadline_seconds"),
+        "elapsed_seconds": report.get("elapsed_seconds"),
+    }
+
+
+def unfinished_executions_from_failure(failure: dict[str, Any] | None) -> list[dict[str, Any]]:
+    """The rh2 report's ``residue.unfinished_executions`` rows for a shutdown failure."""
+
+    rows: list[dict[str, Any]] = []
+    if not failure:
+        return rows
+    for problem in failure.get("problems", []):
+        kind = problem.get("kind")
+        if kind == "active_groups_unfinished":
+            for facts in problem.get("groups") or [{}]:
+                rows.append({"source": "miles_rollout_fn", "reason": "active_group_unfinished_after_deadline", **facts})
+        elif kind == "worker_unfinished":
+            rows.append({"source": "miles_rollout_fn", "reason": "worker_unfinished_after_deadline"})
+    return rows
+
+
+def _same_origin(worker_exc: BaseException | None, driver_cause: str | None) -> bool:
+    """The driver exception is the worker fatal's own propagation (train_async formats it as
+    ``f"{type(exc).__name__}: {str(exc)[:400]}"``): same type name and message prefix."""
+
+    if worker_exc is None or not driver_cause:
+        return False
+    name = type(worker_exc).__name__
+    if not driver_cause.startswith(name + ":"):
+        return False
+    message = str(worker_exc)[:200]
+    return message == "" or message in driver_cause
+
+
