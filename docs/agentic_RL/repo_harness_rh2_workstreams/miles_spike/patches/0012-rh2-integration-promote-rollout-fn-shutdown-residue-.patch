+class ShutdownFailure(RuntimeError):
+    """Typed run failure: the rollout shutdown did not complete cleanly (residue, closure error,
+    or total timeout) and no driver exception is in flight to carry the failure. Raised from
+    ``train_async``'s ``finally`` so the run exits non-zero instead of reporting success."""
+
+    def __init__(self, verdict: dict[str, Any]) -> None:
+        self.verdict = verdict
+        closure = verdict.get("report") if isinstance(verdict.get("report"), dict) else verdict
+        summary = {
+            "timed_out": verdict.get("timed_out"),
+            "errors": verdict.get("errors"),
+            "trigger": closure.get("trigger"),
+            "primary_cause": closure.get("primary_cause"),
+            "secondary_causes": closure.get("secondary_causes"),
+            "original_dispose_error": verdict.get("original_dispose_error"),
+        }
+        super().__init__(f"rollout shutdown failed: {json.dumps(summary, ensure_ascii=False, default=str)[:800]}")
 
 
