diff --git a/miles/utils/types.py b/miles/utils/types.py
index c2ee102f7..a29122686 100644
--- a/miles/utils/types.py
+++ b/miles/utils/types.py
@@ -24,6 +24,77 @@ class RewardSpec:
     custom_rm_path: str | None = None
 
 
+def _validated_weight_version_spans(meta_info: dict) -> list[dict] | None:
+    """[rh2-integration] Return the validated ``meta_info["weight_versions"]``
+    span list, or ``None`` when the key is absent (older engine: the caller
+    falls back to the scalar ``weight_version``).
+
+    The pinned sglang writer (``sglang/srt/utils/weight_versions.py::
+    add_weight_versions_to_meta_info``, commit 4e230c3d) emits
+    ``[{"version": str, "start": int, "end": int}, ...]``: half-open
+    contiguous intervals over generated-token positions starting at 0,
+    adjacent spans merged (so neighbours differ in version), exactly one
+    empty span ``[v, 0, 0)`` for a zero-output request, and the scalar
+    ``weight_version`` always written alongside, equal to the last span's
+    version. ``version`` is explicitly stringified by the writer, so a
+    numeric version on the wire is corruption, not a dialect.
+
+    Any deviation raises ``ValueError`` -- a real exception, not ``assert``:
+    it must survive ``python -O``, and a present-but-broken value (including
+    an explicit ``null`` or ``[]``) must never be treated as "key absent" and
+    silently washed into the scalar fallback, because that would disguise a
+    corrupt staleness account as an old engine. The per-request generated
+    token count is not part of this function's inputs, so the final
+    ``end == num_generated_tokens`` coverage check stays with the caller-side
+    consumers that know it; all structural invariants are enforced here.
+    """
+    if "weight_versions" not in meta_info:
+        return None
+    spans = meta_info["weight_versions"]
+
+    def _bad(detail: str) -> ValueError:
+        return ValueError(f"malformed weight_versions spans from engine ({detail}): {spans!r}")
+
+    if spans is None:
+        raise _bad("explicit null; the writer either omits the key or writes a non-empty list")
+    if not isinstance(spans, list):
+        raise _bad(f"expected a list, got {type(spans).__name__}")
+    if not spans:
+        raise _bad("empty list; the writer emits at least one span")
+    for i, item in enumerate(spans):
+        if not isinstance(item, dict):
+            raise _bad(f"span {i} is {type(item).__name__}, not a dict")
+        missing_keys = {"version", "start", "end"} - item.keys()
+        if missing_keys:
+            raise _bad(f"span {i} misses keys {sorted(missing_keys)}")
+        if not isinstance(item["version"], str) or not item["version"]:
+            raise _bad(f"span {i} version {item['version']!r} is not a non-empty string")
+        for key in ("start", "end"):
+            value = item[key]
+            if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+                raise _bad(f"span {i} {key}={value!r} is not a non-negative int")
+    if spans[0]["start"] != 0:
+        raise _bad(f"first span starts at {spans[0]['start']}, not 0")
+    for prev, cur in zip(spans, spans[1:], strict=False):  # tail is one shorter by design
+        if cur["start"] != prev["end"]:
+            raise _bad(
+                f"spans [{prev['start']},{prev['end']}) and [{cur['start']},{cur['end']}) "
+                "are not contiguous"
+            )
+        if cur["version"] == prev["version"]:
+            raise _bad(f"adjacent spans share version {cur['version']!r}; the writer merges those")
+    if not (len(spans) == 1 and spans[0]["end"] == 0):  # sole legal empty form: zero output
+        for i, item in enumerate(spans):
+            if item["start"] >= item["end"]:
+                raise _bad(f"span {i} [{item['start']},{item['end']}) is empty or inverted")
+    scalar = meta_info.get("weight_version")
+    if scalar is None:
+        raise _bad("scalar weight_version missing; the writer always writes both keys")
+    if str(scalar) != spans[-1]["version"]:
+        raise _bad(f"scalar weight_version {scalar!r} != last span version {spans[-1]['version']!r}")
+    return spans
+
+
 @dataclass
 class Sample:
     """The sample generated"""
@@ -305,11 +376,13 @@ class Sample:
         # buffer's staleness = current - oldest under-reports, letting groups
         # past ``--max-weight-staleness`` that should have been rejected.
         # Append every span version (order preserved; the last one still
-        # equals the scalar, keeping tail semantics unchanged).
-        if spans := meta_info.get("weight_versions"):
-            assert spans[0]["start"] == 0 and all(
-                a["end"] == b["start"] for a, b in zip(spans, spans[1:])
-            ), f"malformed weight_versions spans from engine: {spans}"
+        # equals the scalar, keeping tail semantics unchanged). The spans are
+        # validated first (real exceptions, full writer-contract invariants;
+        # see _validated_weight_version_spans): only a truly absent key means
+        # "older engine, fall back to the scalar" -- a present-but-broken
+        # value must never be washed into the scalar fallback.
+        spans = _validated_weight_version_spans(meta_info)
+        if spans is not None:
             self.weight_versions.extend(s["version"] for s in spans)
         elif "weight_version" in meta_info:
             self.weight_versions.append(meta_info["weight_version"])
