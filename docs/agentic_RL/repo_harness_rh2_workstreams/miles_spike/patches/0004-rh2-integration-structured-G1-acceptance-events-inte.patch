+    def _emit_rollout_evidence(self, rollout_id: int, samples) -> None:
+        """[rh2-integration] Per-rollout structured evidence for G1 acceptance.
+
+        Emits one ``rollout_workers`` event (stable engine identity set for the
+        worker-warm check) and one ``rollout_group`` event per prompt group
+        carrying sample identity, rewards, per-turn behavior weight versions
+        and (under R3) routing-tape digest facts -- the acceptance collector
+        builds ``sample_records.jsonl`` from these instead of torch-loading
+        debug dumps or regex-scraping logs.
+        """
+        worker_ids = []
+        for name, srv in self.servers.items():
+            for pos, engine in enumerate(srv.engines):
+                identity = f"engine{pos}"
+                try:
+                    identity = engine.actor_handle._actor_id.hex()
+                except Exception:  # noqa: BLE001 - identity is best-effort; set stability is what the check needs
+                    pass
+                worker_ids.append(f"{name}/{identity}")
+        rh2_event_log.emit(
+            "rollout_workers",
+            rollout_id=rollout_id,
+            worker_ids=sorted(worker_ids),
+            weight_version=self.weight_version,
+        )
+
+        flat = [s for item in samples for s in (item if isinstance(item, list) else [item])]
+        groups: dict[object, list] = {}
+        for s in flat:
+            groups.setdefault(s.group_index, []).append(s)
+        for group_index, members in groups.items():
+            first = members[0]
+            meta = first.metadata or {}
+            rewards = []
+            for s in members:
+                try:
+                    rewards.append(float(s.get_reward_value(self.args)))
+                except Exception:  # noqa: BLE001 - non-scalar reward stays None; the judge fails loudly on None
+                    rewards.append(None)
