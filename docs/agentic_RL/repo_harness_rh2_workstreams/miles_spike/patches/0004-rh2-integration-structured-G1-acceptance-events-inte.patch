+# --- [rh2-integration] structured acceptance evidence (rh2 G1 / P0-5/P0-6) ---
+
+
+def _optimizer_progress_counts(
+    optimizer: MegatronOptimizer | None,
+    opt_param_scheduler: OptimizerParamScheduler | None,
+    disable_optimizer: bool,
+) -> tuple[int | None, int | None]:
+    """Independent optimizer/scheduler progress counters for step evidence.
+
+    Returns ``(adam_step_count, scheduler_num_steps)``. The Adam count is the
+    max ``step`` recorded in optimizer param groups / per-param state (0 before
+    the first applied step -- Adam state is lazily created); the scheduler
+    count is ``OptimizerParamScheduler.num_steps``. The acceptance judge
+    cross-checks these against ``optimizer_step_applied``: an applied step must
+    advance them, a skipped one must not. The ``NORMAL`` outcome enum alone is
+    not proof of an update (found-inf / debug paths stay NORMAL without an
+    ``optimizer.step()``), hence these independent facts. ``None`` = counter
+    genuinely unavailable; the judge records missing evidence, never a pass.
+    """
+    adam_step = None
+    if not disable_optimizer and optimizer is not None:
+        steps: list[int] = []
+        for chained in getattr(optimizer, "chained_optimizers", []):
+            inner = getattr(chained, "optimizer", None)
+            if inner is None:
+                continue
+            for group in getattr(inner, "param_groups", []):
+                if "step" in group:
+                    steps.append(int(group["step"]))
+            for state in getattr(inner, "state", {}).values():
+                step = state.get("step")
+                if step is not None:
+                    steps.append(int(step.item() if torch.is_tensor(step) else step))
+        adam_step = max(steps) if steps else 0
+    num_steps = getattr(opt_param_scheduler, "num_steps", None) if opt_param_scheduler is not None else None
+    return adam_step, (int(num_steps) if num_steps is not None else None)
+
+
+def _emit_train_step_event(
+    parallel_state,
+    *,
+    rollout_id: int,
+    step_id: int,
+    attempt: int,
+    outcome: TrainStepOutcome,
+    optimizer_step_applied: bool,
+    counts_before: tuple[int | None, int | None],
+    counts_after: tuple[int | None, int | None],
+    grad_norm,
+    duration_seconds: float,
+    loss_reduced: dict[str, float],
+) -> None:
+    dist = torch.distributed
+    is_last_stage = bool(mpu.is_pipeline_last_stage(ignore_virtual=True))
+    rh2_event_log.emit(
+        "train_step",
+        rollout_id=rollout_id,
+        step_id=step_id,
+        attempt=attempt,
+        outcome=outcome.name,
+        optimizer_step_applied=bool(optimizer_step_applied),
+        adam_step_before=counts_before[0],
+        adam_step_after=counts_after[0],
+        scheduler_steps_before=counts_before[1],
+        scheduler_steps_after=counts_after[1],
+        grad_norm=float(grad_norm) if grad_norm is not None else None,
+        duration_seconds=round(duration_seconds, 3),
+        rank=dist.get_rank() if dist.is_available() and dist.is_initialized() else 0,
+        dp_rank=parallel_state.effective_dp.rank,
+        is_pp_last_stage=is_last_stage,
+        metrics={k: float(v) for k, v in loss_reduced.items()} if is_last_stage else None,
+    )
+
+
+def _emit_train_step_consumed(
+    parallel_state,
+    *,
+    rollout_id: int,
+    step_id: int,
+    num_steps: int,
+    rollout_data,
+) -> None:
+    """Record which local sample indices this optimizer step consumed.
+
+    Steps partition each DP rank's shard contiguously (``get_data_iterator``
+    slices ``[step_id * num_local_gbs, (step_id + 1) * num_local_gbs)`` in both
+    the fixed and the dynamic micro-batch schedule -- dynamic balancing only
+    re-partitions *within* a step's range). The collector unions the per-rank
+    shards of one (rollout, step) into the step's consumed-sample fact, used
+    for queue exactly-once accounting and the positive-control "consumed by a
+    real applied optimizer step" proof.
+    """
+    dist = torch.distributed
+    rank = dist.get_rank() if dist.is_available() and dist.is_initialized() else 0
+    sample_indices = rollout_data.get("sample_indices")
+    if sample_indices is None or num_steps <= 0 or len(sample_indices) % num_steps != 0:
+        rh2_event_log.emit(
+            "train_step_consumed",
+            rollout_id=rollout_id,
+            step_id=step_id,
+            dp_rank=parallel_state.effective_dp.rank,
+            rank=rank,
+            sample_indices=None,
+            error=(
+                "sample_indices unavailable"
+                if sample_indices is None
+                else f"shard size {len(sample_indices)} not divisible by num_steps={num_steps}"
+            ),
+        )
+        return
+    per_step = len(sample_indices) // num_steps
+    lo, hi = step_id * per_step, (step_id + 1) * per_step
+    total_lengths = rollout_data.get("total_lengths")
+    rh2_event_log.emit(
+        "train_step_consumed",
+        rollout_id=rollout_id,
+        step_id=step_id,
+        dp_rank=parallel_state.effective_dp.rank,
+        rank=rank,
+        sample_indices=[int(i) for i in sample_indices[lo:hi]],
+        num_tokens=int(sum(total_lengths[lo:hi])) if total_lengths is not None else None,
+    )
+
+
