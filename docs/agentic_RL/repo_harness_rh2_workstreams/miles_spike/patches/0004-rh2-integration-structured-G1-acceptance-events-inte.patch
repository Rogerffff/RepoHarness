diff --git a/miles/utils/rh2_event_log.py b/miles/utils/rh2_event_log.py
new file mode 100644
index 000000000..c86ea1465
--- /dev/null
+++ b/miles/utils/rh2_event_log.py
@@ -0,0 +1,148 @@
+"""[rh2-integration] Structured acceptance-evidence event log (rh2 GPU spike G1).
+
+Production emitters append one JSON object per line to
+``$MILES_RH2_EVENT_DIR/rh2_events_<host>_<pid>.jsonl``. The rh2 acceptance
+collector (``rh2/experiments/miles_gpu_spike/g1_acceptance.py collect``)
+consumes these files instead of regex-scraping ``train.log``; the judge treats
+any missing event as MISSING_EVIDENCE (fail-closed), so emitters must never
+fake data -- an emit failure surfaces as an INCOMPLETE verdict, not a crash.
+
+Everything is a no-op when ``MILES_RH2_EVENT_DIR`` is unset, so upstream
+behavior is unchanged outside rh2 acceptance runs.
+
+This module additionally carries the integration-tree identity assertion
+(rh2 P0-4): every Ray actor calls :func:`assert_and_emit_identity` at startup,
+which records ``miles.__file__`` plus a content digest of the imported miles
+source tree and, when ``RH2_EXPECTED_MILES_TREE_DIGEST`` is set by the
+launcher, hard-fails on mismatch -- a worker silently importing a stock/stale
+miles from the image instead of the pinned integration tree must stop the job,
+not train with unpatched semantics.
+
+Import-light on purpose: no torch/megatron/ray imports, so the driver process
+and every actor kind can use it.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import socket
+import threading
+import time
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+EVENT_DIR_ENV = "MILES_RH2_EVENT_DIR"
+EXPECTED_TREE_DIGEST_ENV = "RH2_EXPECTED_MILES_TREE_DIGEST"
+
+_emit_lock = threading.Lock()
+_emit_failure_logged = False
+_tree_digest_cache: str | None = None
+
+
+def enabled() -> bool:
+    return bool(os.environ.get(EVENT_DIR_ENV))
+
+
+def _json_default(obj: Any) -> Any:
+    # Tensors / numpy scalars carry .item(); everything else degrades to str.
+    item = getattr(obj, "item", None)
+    if callable(item):
+        try:
+            return item()
+        except Exception:  # noqa: BLE001 - best-effort serialization only
+            pass
+    return str(obj)
+
+
+def emit(kind: str, **fields: Any) -> None:
+    """Append one structured event; silently a no-op when disabled.
+
+    A write failure is logged once and otherwise swallowed: evidence loss is
+    fail-closed at judge time (MISSING_EVIDENCE -> INCOMPLETE), and killing a
+    training step over an evidence-file IO error would invert that design.
+    """
+    event_dir = os.environ.get(EVENT_DIR_ENV)
+    if not event_dir:
+        return
+    record = {
+        "event": kind,
+        "ts_unix": round(time.time(), 3),
+        "host": socket.gethostname(),
+        "pid": os.getpid(),
+        **fields,
+    }
+    global _emit_failure_logged
+    try:
+        os.makedirs(event_dir, exist_ok=True)
+        path = os.path.join(event_dir, f"rh2_events_{socket.gethostname()}_{os.getpid()}.jsonl")
+        line = json.dumps(record, ensure_ascii=False, default=_json_default)
+        with _emit_lock, open(path, "a", encoding="utf-8") as fh:
+            fh.write(line + "\n")
+    except Exception:  # noqa: BLE001 - see docstring: fail-closed at judge, not here
+        if not _emit_failure_logged:
+            _emit_failure_logged = True
+            logger.exception("rh2 event emit failed (further failures suppressed)")
+
+
+def miles_tree_digest() -> str:
+    """Content digest of the imported miles source tree (order-stable sha256).
+
+    Hashes every ``*.py`` under the package directory of the *imported* miles
+    module (relative path + content), so two processes agree iff they import
+    byte-identical miles sources -- the launcher pre-computes the same value
+    from ``$MILES_ROOT`` and pins it via ``RH2_EXPECTED_MILES_TREE_DIGEST``.
+    """
+    global _tree_digest_cache
+    if _tree_digest_cache is None:
+        import miles
+
+        root = os.path.dirname(os.path.abspath(miles.__file__))
+        digest = hashlib.sha256()
+        for dirpath, dirnames, filenames in os.walk(root):
+            dirnames[:] = sorted(d for d in dirnames if d != "__pycache__")
+            for name in sorted(f for f in filenames if f.endswith(".py")):
+                path = os.path.join(dirpath, name)
+                rel = os.path.relpath(path, root).replace(os.sep, "/")
+                digest.update(rel.encode("utf-8"))
+                digest.update(b"\0")
+                with open(path, "rb") as fh:
+                    digest.update(hashlib.sha256(fh.read()).digest())
+                digest.update(b"\0")
+        _tree_digest_cache = digest.hexdigest()
+    return _tree_digest_cache
+
+
+def assert_and_emit_identity(role: str) -> None:
+    """Record which miles tree this process imported; stop on a pinned mismatch.
+
+    Called once at startup of every actor kind (megatron trainer, rollout
+    manager, sglang server host) and by the driver. Emits an ``actor_identity``
+    event for the launcher's cross-actor consistency audit, then raises if the
+    launcher pinned an expected digest and this process imported a different
+    tree -- continuing would run unaudited code while the driver-side manifest
+    checks claim otherwise.
+    """
+    expected = os.environ.get(EXPECTED_TREE_DIGEST_ENV) or None
+    if expected is None and not enabled():
+        return
+    import miles
+
+    actual = miles_tree_digest()
+    emit(
+        "actor_identity",
+        role=role,
+        miles_file=os.path.abspath(miles.__file__),
+        tree_digest=actual,
+        expected_tree_digest=expected,
+    )
+    if expected is not None and actual != expected:
+        raise RuntimeError(
+            f"integration tree identity mismatch in role={role}: imported miles at "
+            f"{miles.__file__} has tree digest {actual}, launcher pinned {expected}. "
+            "This process would train/serve with a different miles source tree than "
+            "the audited integration checkout; stopping instead of running unaudited code."
+        )
