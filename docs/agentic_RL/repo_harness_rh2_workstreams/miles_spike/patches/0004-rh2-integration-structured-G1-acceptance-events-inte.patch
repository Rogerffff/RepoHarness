+    def _emit_logprob_compare(self, rollout_id: int, rollout_data: RolloutBatch) -> None:
+        """[rh2-integration] Same-version behavior/current logprob comparison.
+
+        ``log_probs`` were just recomputed by this trainer over the captured
+        tokens (with ``use_rollout_sampling_mask`` under top-p replay, i.e.
+        support-renormalized -- the same normalization as the captured behavior
+        ``rollout_log_probs``), so per-token ``|current - behavior|`` is a
+        like-for-like discrepancy fact for the acceptance judge. Only
+        pp-last-stage ranks hold ``log_probs``; each effective-DP rank reports
+        its own shard, keyed by global sample index.
+        """
+        log_probs = rollout_data.get("log_probs")
+        behavior = rollout_data.get("rollout_log_probs")
+        sample_indices = rollout_data.get("sample_indices")
+        if not log_probs or behavior is None or sample_indices is None:
+            return
+        current_version = int(self.weight_updater.weight_version)
+        versions = rollout_data.get("weight_versions")
+        entries = []
+        for i, sample_index in enumerate(sample_indices):
+            cur = log_probs[i] if i < len(log_probs) else None
+            beh = behavior[i] if i < len(behavior) else None
+            if cur is None or beh is None:
+                continue
+            cur = cur.detach().float().flatten().cpu()
+            beh = beh.detach().float().flatten().cpu()
+            n = min(cur.numel(), beh.numel())
+            if n == 0:
+                continue
+            sample_versions = versions[i] if versions is not None and i < len(versions) else []
+            numeric = [int(v) for v in sample_versions if str(v).isdigit()]
+            same_version = bool(numeric) and all(v == current_version for v in numeric)
+            entries.append(
+                {
+                    "sample_index": int(sample_index),
+                    "same_version": same_version,
+                    "mean_abs_diff": round(float((cur[:n] - beh[:n]).abs().mean()), 6),
+                    "num_tokens": int(n),
+                    "length_mismatch": bool(cur.numel() != beh.numel()),
+                }
+            )
+        rh2_event_log.emit(
+            "logprob_compare",
+            rollout_id=rollout_id,
+            dp_rank=get_parallel_state().effective_dp.rank,
+            trainer_current_version=current_version,
+            entries=entries,
+        )
+
