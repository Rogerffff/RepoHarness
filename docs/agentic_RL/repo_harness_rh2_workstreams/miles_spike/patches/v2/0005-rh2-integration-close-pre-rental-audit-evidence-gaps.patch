new file mode 100644
index 000000000..662338e35
--- /dev/null
+++ b/miles/utils/logprob_compare.py
@@ -0,0 +1,88 @@
+"""[rh2-integration] Same-version behavior/current logprob comparison entries.
+
+Extracted from the megatron actor so the comparison semantics are unit-testable
+without megatron. Accounting rules (rh2 PR-P0-8):
+
+- ``length_mismatch`` is a first-class fact, never silently truncated away: a
+  behavior/current length disagreement means token alignment is broken, and the
+  judge fails on it. The diff is still computed over the common masked prefix
+  for diagnostics.
+- The mean absolute diff counts **only** ``loss_mask == 1`` (provenance)
+  tokens. Observation/tool tokens carry no training gradient and would dilute
+  the discrepancy of the tokens that actually train the model.
+"""
+
+from __future__ import annotations
+
+import torch
+
+
+def masked_compare_entries(
+    *,
+    sample_indices,
+    log_probs,
+    behavior_log_probs,
+    loss_masks,
+    weight_versions,
+    current_version: int,
+) -> list[dict]:
+    """Build one comparison entry per sample of this rank's shard.
+
+    Args are the per-sample columns of ``rollout_data`` (lists indexed the same
+    way). Entries carry: ``sample_index``, ``same_version``, ``length_mismatch``
+    (any pairwise length disagreement between current / behavior / loss mask),
+    ``num_tokens`` (loss_mask==1 tokens actually compared), ``total_tokens``
+    (current logprob length) and ``mean_abs_diff`` over the masked common
+    prefix (``None`` when no masked token exists).
+    """
+    entries: list[dict] = []
+    for i, sample_index in enumerate(sample_indices):
+        cur = log_probs[i] if i < len(log_probs) else None
+        beh = behavior_log_probs[i] if i < len(behavior_log_probs) else None
+        if cur is None or beh is None:
+            continue
+        cur = cur.detach().float().flatten().cpu()
+        beh = beh.detach().float().flatten().cpu()
+        mask = None
+        if loss_masks is not None and i < len(loss_masks) and loss_masks[i] is not None:
+            mask = torch.as_tensor(loss_masks[i]).detach().flatten().cpu()
+        if mask is None:
+            # No provenance mask shipped for this sample: that is itself a
+            # broken-alignment fact -- record it instead of falling back to an
+            # all-token mean that the judge would mistake for the trained-token
+            # discrepancy.
+            entries.append(
+                {
+                    "sample_index": int(sample_index),
+                    "same_version": _same_version(weight_versions, i, current_version),
+                    "length_mismatch": True,
+                    "num_tokens": 0,
+                    "total_tokens": int(cur.numel()),
+                    "mean_abs_diff": None,
+                }
+            )
+            continue
+        length_mismatch = not (cur.numel() == beh.numel() == mask.numel())
+        n = min(cur.numel(), beh.numel(), mask.numel())
+        masked = mask[:n] != 0
+        num_masked = int(masked.sum())
+        mean_abs_diff = (
+            round(float((cur[:n][masked] - beh[:n][masked]).abs().mean()), 6) if num_masked else None
+        )
+        entries.append(
+            {
+                "sample_index": int(sample_index),
+                "same_version": _same_version(weight_versions, i, current_version),
+                "length_mismatch": bool(length_mismatch),
+                "num_tokens": num_masked,
+                "total_tokens": int(cur.numel()),
+                "mean_abs_diff": mean_abs_diff,
+            }
+        )
+    return entries
+
+
+def _same_version(weight_versions, i: int, current_version: int) -> bool:
+    sample_versions = weight_versions[i] if weight_versions is not None and i < len(weight_versions) else []
+    numeric = [int(v) for v in sample_versions if str(v).isdigit()]
+    return bool(numeric) and all(v == current_version for v in numeric)
