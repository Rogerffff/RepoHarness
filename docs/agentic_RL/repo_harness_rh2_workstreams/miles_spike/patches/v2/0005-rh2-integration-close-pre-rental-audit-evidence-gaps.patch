diff --git a/miles/utils/step_attribution.py b/miles/utils/step_attribution.py
new file mode 100644
index 000000000..f27f9e902
--- /dev/null
+++ b/miles/utils/step_attribution.py
@@ -0,0 +1,66 @@
+"""[rh2-integration] Map one optimizer step to the local sample positions it consumes.
+
+The acceptance event ``train_step_consumed`` must attribute every sample to the
+optimizer step that actually trained on it. The DataIterator consumption order
+is the single source of truth:
+
+- dynamic / rollout-side scheduled path: ``micro_batch_indices`` is one flat
+  list of micro-batches covering the whole rollout; step ``s`` consumes the
+  micro-batches ``[sum(num_microbatches[:s]), sum(num_microbatches[:s+1]))``.
+  Step sample counts are **not** equal in general -- variable fan-out packs a
+  different number of samples into each step (e.g. rollout_ids
+  ``[0,0,0,1,1,1,2,3]`` with global_batch_size=2 rollouts and dp=2 gives one
+  rank 3 samples in step 0 and 1 sample in step 1), so any equal-split
+  inference silently mis-attributes samples across steps.
+- fixed micro-batch path: step ``s`` consumes the contiguous slice of
+  ``micro_batch_size * num_microbatches[s]`` samples starting after the
+  previous steps' slices.
+
+Pure and torch-free so the mapping is unit-testable against
+``miles.utils.dp_schedule.build_dp_schedule`` outputs without megatron.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+
+def step_local_sample_positions(
+    *,
+    step_id: int,
+    num_microbatches: Sequence[int],
+    micro_batch_indices: Sequence[Sequence[int]] | None,
+    micro_batch_size: int | None,
+    num_local_samples: int,
+) -> list[int]:
+    """Local sample positions (indices into this rank's shard) consumed by ``step_id``.
+
+    Mirrors ``DataIterator.get_next`` exactly: the iterator either walks
+    ``micro_batch_indices`` one micro-batch per call, or advances a contiguous
+    ``micro_batch_size`` window. Raises ``ValueError`` on any inconsistency
+    (out-of-range step, schedule shorter than the step span, positions outside
+    the shard) -- the caller records the error as evidence instead of guessing.
+    """
+    if not 0 <= step_id < len(num_microbatches):
+        raise ValueError(f"step_id {step_id} out of range for num_microbatches={list(num_microbatches)}")
+    if micro_batch_indices is not None:
+        start = sum(num_microbatches[:step_id])
+        stop = start + num_microbatches[step_id]
+        if stop > len(micro_batch_indices):
+            raise ValueError(
+                f"micro_batch_indices has {len(micro_batch_indices)} micro-batches, "
+                f"step {step_id} needs [{start}, {stop})"
+            )
+        positions = [int(i) for mb in micro_batch_indices[start:stop] for i in mb]
+    else:
+        if micro_batch_size is None:
+            raise ValueError("neither micro_batch_indices nor micro_batch_size available")
+        sizes = [int(n) * int(micro_batch_size) for n in num_microbatches]
+        start = sum(sizes[:step_id])
+        positions = list(range(start, start + sizes[step_id]))
+    bad = [p for p in positions if not 0 <= p < num_local_samples]
+    if bad:
+        raise ValueError(
+            f"step {step_id} positions {bad[:4]} outside local shard of {num_local_samples} samples"
+        )
+    return positions
