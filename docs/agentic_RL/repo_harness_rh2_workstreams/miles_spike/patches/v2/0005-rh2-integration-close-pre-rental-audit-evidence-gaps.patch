+def replay_sample_digests(tensors) -> list[str] | None:
+    """[rh2-integration] Per-sample content digests of a replay tape column.
+
+    sha256 over the row-major element buffer, matching how the rollout manager
+    digests ``Sample.rollout_routed_experts`` (numpy ``tobytes()``), so a
+    converted trainer-side tape hashes equal to its rollout-side source iff the
+    values, dtype and layout survived the conversion. Used by the acceptance
+    ``replay_fill`` event to link trainer consumption back to the shipped tape.
+    """
+    if tensors is None:
+        return None
+    digests = []
+    for t in tensors:
+        arr = t.detach().cpu().contiguous().numpy() if torch.is_tensor(t) else t
+        digests.append(hashlib.sha256(arr.tobytes()).hexdigest())
+    return digests
+
