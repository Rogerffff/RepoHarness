-
-        Order (rh2 06 plan W5a): stop new submissions -> cancel and await the worker ->
-        cancel and await the active group tasks -> close the data buffer so waiters blocked
-        in put()/get() exit with DataBufferClosed. The worker's own exception (for example a
-        group-admission fatal raised inside buffer.put()) is preserved as
-        ``worker_exception`` so the caller can hand it to the rh2 shutdown report as the
-        first cause. Never raises; returns the same report on repeated calls.
+    async def aclose(self, deadline_seconds: float | None = None) -> dict:
+        """[rh2-integration] W5a: stop the producer and wake every waiter (idempotent, bounded).
+
+        Must run on the loop that owns the worker (the shared AsyncLoopThread; see
+        miles/utils/rh2_shutdown.py for how RolloutManager.dispose() posts it there).
+
+        Order (rh2 06 plan W5a): stop new submissions -> cancel the worker and wait up to the
+        deadline -> cancel the active group tasks and wait for the remaining deadline ->
+        **always** (finally) close the data buffer so waiters blocked in put()/get() exit
+        with DataBufferClosed. Tasks still running when the deadline passes are abandoned
+        (``worker_unfinished`` / ``active_groups_unfinished``, ``deadline_exceeded=True``);
+        their containers/sessions are the rh2 shutdown chain's job. The worker's own
+        exception (for example a group-admission fatal raised inside buffer.put()) is
+        preserved as ``worker_exception`` for the rh2 shutdown report's first cause.
+        Never raises; returns the same report on repeated calls.
         """
         if self._close_report is not None:
             return self._close_report
         self._closed = True
+        deadline = shutdown_deadline_seconds(self.args) if deadline_seconds is None else float(deadline_seconds)
+        started = time.monotonic()
         report: dict = {
             "worker_state": "never_started",
             "worker_exception": None,
+            "worker_unfinished": False,
             "active_groups_cancelled": 0,
+            "active_groups_unfinished": 0,
+            "deadline_seconds": deadline,
+            "deadline_exceeded": False,
             "buffer_closed": False,
+            "close_error": None,
+            "elapsed_seconds": 0.0,
         }
-        worker = self._worker
-        if worker is not None:
-            if not worker.done():
-                worker.cancel()
-                await asyncio.wait({worker})
-            if worker.cancelled():
-                report["worker_state"] = "cancelled"
-            elif worker.exception() is not None:
-                report["worker_state"] = "failed"
-                report["worker_exception"] = worker.exception()
-            else:
-                report["worker_state"] = "returned"
-        active = [task for task in self._active_groups if not task.done()]
-        for task in active:
-            task.cancel()
-        if active:
-            await asyncio.wait(active)
-        report["active_groups_cancelled"] = len(active)
-        if self._output is not None and (aclose := getattr(self._output, "aclose", None)) is not None:
-            await aclose()
-            report["buffer_closed"] = True
-        self._close_report = report
+
+        def remaining() -> float:
+            return max(deadline - (time.monotonic() - started), 0.0)
+
+        try:
+            worker = self._worker
+            if worker is not None:
+                if not worker.done():
+                    worker.cancel()
+                    await asyncio.wait({worker}, timeout=remaining())
+                if not worker.done():
+                    report["worker_state"] = "unfinished"
+                    report["worker_unfinished"] = True
+                elif worker.cancelled():
+                    report["worker_state"] = "cancelled"
+                elif worker.exception() is not None:
+                    report["worker_state"] = "failed"
+                    report["worker_exception"] = worker.exception()
+                else:
+                    report["worker_state"] = "returned"
+            active = [task for task in self._active_groups if not task.done()]
+            for task in active:
+                task.cancel()
+            if active:
+                await asyncio.wait(active, timeout=remaining())
+            report["active_groups_cancelled"] = len(active)
+            report["active_groups_unfinished"] = sum(1 for task in active if not task.done())
+            report["deadline_exceeded"] = bool(report["worker_unfinished"] or report["active_groups_unfinished"])
+            if report["deadline_exceeded"]:
+                logger.error(
+                    "[rh2-integration] rollout fn aclose(): deadline %.1fs exceeded; abandoning worker_unfinished=%s "
+                    "active_groups_unfinished=%d to the rh2 shutdown chain",
+                    deadline,
+                    report["worker_unfinished"],
+                    report["active_groups_unfinished"],
+                )
+        except Exception as exc:  # noqa: BLE001 - shutdown must reach the buffer close and the rh2 chain
+            report["close_error"] = repr(exc)
+            logger.exception("[rh2-integration] rollout fn aclose() failed before the buffer close")
+        finally:
+            # Always wake put()/get() waiters, whatever happened above.
+            if self._output is not None and (aclose := getattr(self._output, "aclose", None)) is not None:
+                try:
+                    await aclose()
+                    report["buffer_closed"] = True
+                except Exception as exc:  # noqa: BLE001
+                    report["close_error"] = report["close_error"] or repr(exc)
+                    logger.exception("[rh2-integration] data buffer aclose() failed")
+            report["elapsed_seconds"] = round(time.monotonic() - started, 3)
+            self._close_report = report
         return report
 
     @property
diff --git a/miles/utils/rh2_shutdown.py b/miles/utils/rh2_shutdown.py
new file mode 100644
index 000000000..822458c00
--- /dev/null
+++ b/miles/utils/rh2_shutdown.py
@@ -0,0 +1,146 @@
+"""[rh2-integration] W5a (patch 0011): run the rollout-fn / rh2 shutdown on the loop that owns them.
+
+Production topology: ``RolloutManager._get_rollout_data`` calls the rollout fn through
+``asyncio.to_thread(call_rollout_function, ...)`` and ``compatibility.call_rollout_function``
+hands the coroutine to ``async_utils.run`` -> the global background ``AsyncLoopThread``
+(``get_async_loop()``). So ``FullyAsyncRolloutFn``, its worker task, the ``DefaultDataBuffer``
+and the rh2 ``BringupService`` (bootstrapped inside the first generate call) all live on
+**that** loop, not on the Ray actor's loop. Awaiting their tasks/futures from the actor loop
+is undefined: a cross-loop future completing does not wake the actor loop, so
+``dispose.remote()`` can hang until some unrelated timer fires.
+
+``dispose_on_owner_loop`` therefore posts the whole closure (rollout fn ``aclose`` -> first
+cause extraction -> rh2 ``close_bringup_service``) to the owner loop with
+``run_coroutine_threadsafe`` and awaits the resulting concurrent future through
+``asyncio.wrap_future`` (which wakes the calling loop via ``call_soon_threadsafe``) under a
+total timeout. The rollout fn's own cancel-and-wait is bounded by
+``shutdown_deadline_seconds`` (``RH2_MILES_SHUTDOWN_DEADLINE_SEC`` / ``args.rh2_shutdown_deadline_sec``);
+the total dispose budget is ``RH2_MILES_DISPOSE_TIMEOUT_SEC`` / ``args.rh2_dispose_timeout_sec``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+from typing import Any
+
+from miles.utils.async_utils import get_async_loop
+
+logger = logging.getLogger(__name__)
+
+# Total budget for the owner-loop closure: rollout fn deadline (default 60s) + the rh2
+# shutdown chain, whose own per-step bounds sum to roughly 6 minutes with defaults
+# (RH2_SHUTDOWN_*_SEC). Exceeding it logs, records ``timed_out`` and lets the original
+# dispose continue; the closure task keeps running on the owner loop (the rh2 chain is
+# internally shielded).
+DEFAULT_DISPOSE_TIMEOUT_SEC = 900.0
+
+
+def dispose_timeout_seconds(args: Any = None) -> float:
+    value = getattr(args, "rh2_dispose_timeout_sec", None) if args is not None else None
+    if value is None:
+        value = os.environ.get("RH2_MILES_DISPOSE_TIMEOUT_SEC")
+    if value is None or value == "":
+        return DEFAULT_DISPOSE_TIMEOUT_SEC
+    value = float(value)
+    if value <= 0:
+        raise ValueError(f"dispose timeout must be > 0, got {value}")
+    return value
+
+
+def _describe(exc: BaseException | str | None) -> str | None:
+    if exc is None:
+        return None
+    if isinstance(exc, BaseException):
+        code = getattr(exc, "reason_code", None)
+        head = f"{type(exc).__name__}({code})" if code else type(exc).__name__
+        return f"{head}: {str(exc)[:300]}"
+    return str(exc)[:400]
+
+
+async def close_rollout_fn_and_rh2(
+    generate_rollout: Any,
+    *,
+    driver_cause: str | None = None,
+    deadline_seconds: float | None = None,
+) -> dict[str, Any]:
+    """The closure itself. **Runs on the owner loop** (post it with ``dispose_on_owner_loop``).
+
+    Order: rollout fn ``aclose`` (stop submissions -> bounded cancel/await worker + active
+    groups -> buffer close in finally) -> first cause = the worker's own exception if any,
+    else ``driver_cause`` -> rh2 ``close_bringup_service`` with that first cause. Every stage
+    swallows and records its failure so the next stage still runs. Never raises.
+    """
+
+    report: dict[str, Any] = {
+        "rollout_fn": None,
+        "first_cause": None,
+        "trigger": "owner_close",
+        "rh2": None,
+        "errors": [],
+    }
+    first_cause: BaseException | str | None = None
+    aclose = getattr(generate_rollout, "aclose", None)
+    if aclose is not None:
+        try:
+            fn_report = await (aclose(deadline_seconds=deadline_seconds) if deadline_seconds is not None else aclose())
+            first_cause = fn_report.get("worker_exception")
+            report["rollout_fn"] = {
+                key: (_describe(value) if key == "worker_exception" else value) for key, value in fn_report.items()
+            }
+        except Exception as exc:  # noqa: BLE001
+            report["errors"].append(f"aclose: {exc!r}")
+            logger.exception("[rh2-integration] rollout fn aclose() failed")
+    if first_cause is not None:
+        trigger = "run_fatal"  # the worker's own fatal is the most precise original cause
+    elif driver_cause:
+        first_cause, trigger = driver_cause, "driver_error"
+    else:
+        trigger = "owner_close"
+    report["first_cause"] = _describe(first_cause)
+    report["trigger"] = trigger
+    try:
+        from repoharness2.adapters.slime.bringup import close_bringup_service
+    except ImportError:  # rh2 not on the path (stock miles usage): nothing to close
+        close_bringup_service = None
+    if close_bringup_service is not None:
+        try:
+            rh2_report = await close_bringup_service(
+                reason="rollout_manager_dispose", trigger=trigger, first_cause=first_cause
+            )
+            report["rh2"] = (
+                None
+                if rh2_report is None
+                else {"ok": rh2_report.ok, "first_cause": rh2_report.first_cause, "residue": dict(rh2_report.residue)}
+            )
+        except Exception as exc:  # noqa: BLE001
+            report["errors"].append(f"close_bringup_service: {exc!r}")
+            logger.exception("[rh2-integration] rh2 close_bringup_service() failed")
+    return report
+
+
+async def dispose_on_owner_loop(
+    generate_rollout: Any,
+    *,
+    driver_cause: str | None = None,
+    deadline_seconds: float | None = None,
+    timeout_seconds: float | None = None,
+    args: Any = None,
+) -> dict[str, Any]:
+    """Call this **from the actor loop**: posts ``close_rollout_fn_and_rh2`` to the shared
+    background loop and awaits it through a threadsafe future with a total timeout.
+    Never raises; on timeout returns ``{"timed_out": True, ...}`` (the closure keeps running
+    on the owner loop; the caller proceeds with the rest of dispose)."""
+
+    timeout = dispose_timeout_seconds(args) if timeout_seconds is None else float(timeout_seconds)
+    owner = get_async_loop()
+    concurrent_future = asyncio.run_coroutine_threadsafe(
+        close_rollout_fn_and_rh2(generate_rollout, driver_cause=driver_cause, deadline_seconds=deadline_seconds),
+        owner.loop,
+    )
+    try:
+        return await asyncio.wait_for(asyncio.shield(asyncio.wrap_future(concurrent_future)), timeout=timeout)
+    except (TimeoutError, asyncio.TimeoutError):
+        logger.error("[rh2-integration] dispose closure did not finish within %.1fs; continuing without it", timeout)
+        return {"timed_out": True, "timeout_seconds": timeout, "first_cause": _describe(driver_cause), "errors": []}
