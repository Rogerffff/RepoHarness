index 8015d0daf..80af7f5bd 100644
--- a/miles/backends/megatron_utils/ft/types.py
+++ b/miles/backends/megatron_utils/ft/types.py
@@ -1,3 +1,4 @@
+from collections.abc import Sequence
 from enum import auto
 
 try:
@@ -9,3 +10,90 @@ except ImportError:
 class TrainStepOutcome(StrEnum):
     NORMAL = auto()
     DISCARDED_SHOULD_RETRY = auto()
+    # [rh2-integration] Zero-signal skip (FA-4 §4 semantics): the fully reduced
+    # gradient of this optimizer step is exactly zero on every trainer rank, so
+    # optimizer.step()/scheduler.step() were skipped to keep parameters and
+    # optimizer state (AdamW weight decay / momentum would otherwise mutate
+    # them with no training signal). The batch is consumed; the step is
+    # non-fatal and reported through TrainRolloutReport so the driver can also
+    # skip weight publishing (weight_version must not grow without an update).
+    SKIPPED_ZERO_SIGNAL = auto()
+
+
+class TrainRolloutReport(str):
+    """[rh2-integration] Aggregated result of one ``train()`` call.
+
+    One ``train()`` call can contain several optimizer steps (e.g. 64 samples
+    with a global batch size of 32 gives two steps), so a single final-step
+    ``TrainStepOutcome`` cannot tell the driver whether any real parameter
+    update happened. This report carries the per-rollout facts.
+
+    It subclasses ``str`` with the rollout-level outcome as its string value,
+    so every existing call site that compares the ``train()`` return value
+    against ``TrainStepOutcome`` members (a StrEnum) keeps working unchanged
+    (``report == TrainStepOutcome.NORMAL`` etc.), while new consumers (the
+    async driver's weight-publish gate) read attributes. Instances survive
+    Ray/cloudpickle transport with attributes intact (``__getnewargs__``
+    restores the string value, the instance ``__dict__`` restores the rest);
+    this module stays import-light so the driver process can unpickle it
+    without pulling in megatron.
+
+    Rollout-level string value:
+      - ``discarded_should_retry`` if any step was discarded (only possible
+        for single-step indep-dp rollouts; unchanged semantics);
+      - ``skipped_zero_signal`` only if *every* optimizer step was a
+        zero-signal skip (weights provably unchanged since the call started);
+      - ``normal`` otherwise: a mixed rollout (one skip + one applied step)
+        must still count as NORMAL so weight backup/publish paths run.
+    """
+
+    applied_optimizer_steps: int
+    skipped_zero_signal_steps: int
+    weights_dirty: bool
+
+    def __new__(
+        cls,
+        outcome_value: str,
+        *,
+        applied_optimizer_steps: int = 0,
+        skipped_zero_signal_steps: int = 0,
+        weights_dirty: bool = True,
+    ) -> "TrainRolloutReport":
+        self = str.__new__(cls, outcome_value)
+        self.applied_optimizer_steps = applied_optimizer_steps
+        self.skipped_zero_signal_steps = skipped_zero_signal_steps
+        self.weights_dirty = weights_dirty
+        return self
+
+    def __getnewargs__(self) -> tuple[str]:
+        # Pickle support: the string value is a __new__ argument (str is
+        # immutable); the attribute dict is restored separately as state.
+        return (str(self),)
+
+    @classmethod
+    def from_step_outcomes(cls, step_outcomes: Sequence[TrainStepOutcome]) -> "TrainRolloutReport":
+        all_skipped = bool(step_outcomes) and all(
+            o == TrainStepOutcome.SKIPPED_ZERO_SIGNAL for o in step_outcomes
+        )
+        if any(o == TrainStepOutcome.DISCARDED_SHOULD_RETRY for o in step_outcomes):
+            value = TrainStepOutcome.DISCARDED_SHOULD_RETRY
+        elif all_skipped:
+            value = TrainStepOutcome.SKIPPED_ZERO_SIGNAL
+        else:
+            value = TrainStepOutcome.NORMAL
+        # ``applied_optimizer_steps`` counts steps that went down the normal
+        # (non-skipped, non-discarded) path. Pre-existing conflation is kept
+        # on purpose: a found-inf invalid step or debug_disable_optimizer run
+        # applies no real optimizer.step() yet still counts as NORMAL, exactly
+        # as before this report existed. ``weights_dirty`` is therefore
+        # conservative: it is False only when the rollout *provably* changed
+        # nothing (every step was a zero-signal skip); any other case keeps
+        # the historical "publish on interval" behavior.
+        return cls(
+            str(value),
+            applied_optimizer_steps=sum(1 for o in step_outcomes if o == TrainStepOutcome.NORMAL),
+            skipped_zero_signal_steps=sum(
+                1 for o in step_outcomes if o == TrainStepOutcome.SKIPPED_ZERO_SIGNAL
+            ),
+            weights_dirty=not all_skipped,
+        )
