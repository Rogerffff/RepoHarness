+#   rh2_physical_attempt_id  identity.py ATTEMPT_ID_KEY（本次物理执行身份）
+RH2_ADMISSION_METADATA_KEY = "rh2_admission"
+RH2_PROMPT_GROUP_ID_KEY = "rh2_prompt_group_id"
+RH2_MEMBER_SLOT_KEY = "rh2_member_slot"
+RH2_PHYSICAL_ATTEMPT_ID_KEY = "rh2_physical_attempt_id"
+
+
+def _sample_meta(sample: Any) -> dict:
+    meta = getattr(sample, "metadata", None)
+    return meta if isinstance(meta, dict) else {}
+
+
+def group_claims_formal(group: Group) -> bool:
+    """[rh2-integration] W4：组是否声称来自 rh2 formal 交付链（任一成员带 admission 载荷）。"""
+    return any(RH2_ADMISSION_METADATA_KEY in _sample_meta(s) for s in iter_samples(group))
+
+
+def group_identity_facts(group: Group) -> dict[str, Any]:
+    """[rh2-integration] W4：组的可序列化身份事实（drop / consumed 事件与 fatal 消息共用）。
+
+    只取标识（task/instance/prompt id、组身份、成员 index），不取 prompt/response/patch 内容。
+    """
+    samples = list(iter_samples(group))
+    first = samples[0] if samples else None
+    meta = _sample_meta(first) if first is not None else {}
+    return {
+        "group_index": getattr(first, "group_index", None) if first is not None else None,
+        "sample_indices": [getattr(s, "index", None) for s in samples],
+        "member_count": len(group),
+        "task_id": meta.get("task_id"),
+        "instance_id": meta.get("instance_id"),
+        "prompt_id": meta.get("prompt_id"),
+        "rh2_prompt_group_id": meta.get(RH2_PROMPT_GROUP_ID_KEY),
+        "formal": group_claims_formal(group),
+    }
+
+
+class WeightVersionAccountingError(RuntimeError):
+    """[rh2-integration] W4（决策包 D2+B v2 B-1）：consume-time 版本账目矛盾——不是 stale，是 run-fatal。
+
+    ``reason_code``：
+      negative_consume_time_staleness  组最老行为版本 > 消费时刻已发布版本（current − oldest < 0）；
+                                       stale 判定的前提（行为版本不晚于已发布版本）被打破，"满足任何
+                                       阈值"是账目错误而不是新鲜；
+      weight_version_facts_missing     声称 formal 的组没有任何可解析的行为版本（oldest=None）；
+      current_version_missing          声称 formal 的组在消费时刻拿不到已发布版本事实（current=None）。
+
+    在 ``DefaultDataBuffer.get()`` 抛出：经 FullyAsyncRolloutFn._drain → RolloutManager.generate →
+    driver 的 train_async 循环异常 → finally dispose(driver_cause) → rh2 关停链，首因 = 本异常
+    （与 group filter 在 put() 内抛 GroupAdmissionFatal 走的是同一条关停链，只是入口在消费侧）。
+    非 formal 的组（无 admission 载荷，例如 s1_compat / mock 链）保持 stock 行为：无版本事实即不判定。
+    """
+
+    def __init__(
+        self,
+        reason_code: str,
+        message: str,
+        *,
+        oldest_weight_version: int | None,
+        current_weight_version: int | None,
+        group_facts: dict[str, Any],
+    ) -> None:
+        self.reason_code = reason_code
+        self.oldest_weight_version = oldest_weight_version
+        self.current_weight_version = current_weight_version
+        self.group_facts = group_facts
+        super().__init__(f"{reason_code}: {message} group={group_facts}")
+
