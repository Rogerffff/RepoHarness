+def no_progress_limit_seconds(args) -> float | None:
+    """[rh2-integration] W4（决策包 D2+B v2 B-2）：``--rh2-max-time-without-accepted-group`` 的读取。
+
+    None（默认）= 不启用。数值归决策包 C，这里只做机制；非正数直接拒绝（0 会让第一次等待就停）。
+    用 getattr 读取：老的 Namespace 测试面没有这个属性时等价于未启用。
+    """
+    value = getattr(args, "rh2_max_time_without_accepted_group", None)
+    if value is None:
