@@ -256,7 +397,50 @@ class DefaultDataBuffer(DataBuffer):
 
     @staticmethod
     def _staleness(group: Group, current_version: int | None) -> int | None:
+        """纯算术（get_metrics 的 buffer 观测用）；消费判定走 _judge_consume_time_staleness。"""
         oldest = group_oldest_weight_version(group)
         if oldest is None or current_version is None:
             return None
         return current_version - oldest
+
+    @staticmethod
+    def _judge_consume_time_staleness(group: Group, current_version: int | None) -> tuple[int | None, int | None]:
+        """[rh2-integration] W4：consume-time 判定的事实层，返回 (oldest, staleness)。
+
+        - 非 formal 组且缺任一版本事实 → (oldest, None)：stock 语义，不判定、原样交出；
+        - formal 组缺版本事实 → WeightVersionAccountingError（weight_version_facts_missing /
+          current_version_missing）；
+        - current − oldest < 0 → WeightVersionAccountingError（negative_consume_time_staleness），
+          formal 与否都拒绝：负 lag 对任何组都是版本管道错乱，不存在"合法的未来行为版本"。
+        """
+        oldest = group_oldest_weight_version(group)
+        if oldest is None or current_version is None:
+            if group_claims_formal(group):
+                facts = group_identity_facts(group)
+                if oldest is None:
+                    raise WeightVersionAccountingError(
+                        "weight_version_facts_missing",
+                        "声称 formal 的组没有任何可解析的行为版本，consume-time staleness 无法判定",
+                        oldest_weight_version=oldest,
+                        current_weight_version=current_version,
+                        group_facts=facts,
+                    )
+                raise WeightVersionAccountingError(
+                    "current_version_missing",
+                    "消费时刻没有已发布版本事实（current_version=None），formal 组不得在无判定下交给 trainer",
+                    oldest_weight_version=oldest,
+                    current_weight_version=current_version,
+                    group_facts=facts,
+                )
+            return oldest, None
+        staleness = current_version - oldest
+        if staleness < 0:
+            raise WeightVersionAccountingError(
+                "negative_consume_time_staleness",
+                f"组最老行为版本 {oldest} 晚于消费时刻已发布版本 {current_version}"
+                f"（staleness={staleness} < 0）——版本账目矛盾，不是新鲜组",
+                oldest_weight_version=oldest,
+                current_weight_version=current_version,
+                group_facts=group_identity_facts(group),
+            )
+        return oldest, staleness
