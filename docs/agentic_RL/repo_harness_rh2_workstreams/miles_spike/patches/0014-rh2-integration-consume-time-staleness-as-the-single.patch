+class NoProgressTimeout(RuntimeError):
+    """[rh2-integration] W4（决策包 D2+B v2 B-2 no-progress）：trainer 等待"最终可训练 group"超时。
+
+    语义："progress" = ``DefaultDataBuffer.get()`` 交出一个通过 consume-time staleness 判定的组
+    （被 put 拒绝、被 filter 拒绝、被 get 判 stale 的组**不是** progress——持续完成又持续丢弃不会
+    重置计时）。计时只在 trainer 等待下一组的期间累积：在 ``_drain`` 入口和每次接受一组时重置，
+    训练/eval 期间（没有人在等组）不计。累计等待超过 ``--rh2-max-time-without-accepted-group``
+    即抛出本异常（reason_code=no_accepted_group_within_limit）：它从 ``_drain`` 传到
+    RolloutManager.generate → driver 的 train_async 循环 → finally dispose(driver_cause) → rh2
+    关停链，首因就是本异常，消息里带 buffer 的累计接受/丢弃计数与队列深度，便于一眼区分
+    "producer 死了"与"producer 在产但全被 drop"。
+    """
+
+    reason_code = "no_accepted_group_within_limit"
+
+    def __init__(self, *, limit_seconds: float, waited_seconds: float, facts: dict) -> None:
+        self.limit_seconds = limit_seconds
+        self.waited_seconds = waited_seconds
+        self.facts = facts
+        super().__init__(
+            f"{self.reason_code}: no group passed the consume-time staleness verdict for "
+            f"{waited_seconds:.1f}s (limit {limit_seconds:.1f}s); facts={facts}"
+        )
+
+
