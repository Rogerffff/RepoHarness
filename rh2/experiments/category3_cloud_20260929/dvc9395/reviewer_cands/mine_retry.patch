+    def _pull_missing_outputs(self, jobs=None) -> None:
+        """Download and checkout outputs that are missing from the workspace."""
+        missing = [out for out in self.outs if out.use_cache and not out.exists]
+        for out in missing:
+            logger.info("Pulling missing output '%s' of %s", out, self)
+            for odb, objs in out.get_used_objs().items():
+                if objs:
+                    self.repo.cloud.pull(objs, jobs=jobs, odb=odb)
+            out.checkout(allow_missing=True)
+
     def filter_outs(self, fs_path) -> Iterable["Output"]:
         def _func(o):
