+
+
+@pytest.mark.parametrize(
+    'field_type,default_value,expected_schema',
+    [
+        (
+            IPvAnyAddress,
+            IPv4Address('127.0.0.1'),
+            {
+                'properties': {
+                    'field': {'default': '127.0.0.1', 'format': 'ipvanyaddress', 'title': 'Field', 'type': 'string'}
+                },
+                'title': 'Model',
+                'type': 'object',
+            },
+        ),
+        (
+            IPvAnyAddress,
+            IPv6Address('::1'),
+            {
+                'properties': {
+                    'field': {'default': '::1', 'format': 'ipvanyaddress', 'title': 'Field', 'type': 'string'}
+                },
+                'title': 'Model',
+                'type': 'object',
+            },
+        ),
+    ],
+)
+def test_default_value_encoding(field_type, default_value, expected_schema):
+    class Model(BaseModel):
+        field: field_type = default_value
+
+    schema = Model.model_json_schema()
+    assert schema == expected_schema
+
+    # Encoding such defaults must keep working for defaults that were already JSON serializable,
+    # e.g. a standard library dataclass instance (documented BaseModel + stdlib dataclass usage)
+    @dataclasses.dataclass
+    class Point:
+        x: int
+
+    class WithDataclassDefault(BaseModel):
+        point: Point = Point(1)
+
+    assert WithDataclassDefault.model_json_schema()['properties']['point']['default'] == {'x': 1}
