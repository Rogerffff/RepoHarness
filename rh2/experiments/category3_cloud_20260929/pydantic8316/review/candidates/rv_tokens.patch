+    # tokenize into words (an acronym is a run of capitals not followed by a lowercase letter), then join with '_'
+    tokens = re.findall(r'_+|[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+|[^A-Za-z0-9_]+', camel)
+    out = []
+    for tok in tokens:
+        if out and re.match(r'[A-Za-z0-9]', tok) and re.search(r'[A-Za-z0-9]$', out[-1]):
+            out.append('_')
+        out.append(tok)
+    return ''.join(out).lower()
